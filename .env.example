# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key
# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_IMAGES_BUCKET=dragon-images

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EVAL_MODEL=gpt-5.5

# Local/test fallback. Production should leave this unset or set to openai.
AI_PROVIDER=openai

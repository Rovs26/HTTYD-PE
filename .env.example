# App
# Set this to the canonical HTTPS origin in Vercel (without a trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate a unique random value of at least 32 characters. Server-only.
APP_SECRET=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key
# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Must match the bucket created by supabase/migrations/0001_init.sql. Changing this without
# creating the matching bucket makes every image upload fail.
SUPABASE_IMAGES_BUCKET=dragon-images

# OpenAI
# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
# Image quality is capped in code to low or medium. high/auto/hd are forced to medium.
OPENAI_CHALLENGE_IMAGE_QUALITY=medium
OPENAI_STUDENT_IMAGE_QUALITY=medium
OPENAI_PROMPT_MODEL=gpt-5.4-mini
OPENAI_EVAL_MODEL=gpt-5.4-mini
OPENAI_VISION_DETAIL=low
# Per-request timeout for OpenAI calls, in ms. Guards the generation queue against a hung request.
OPENAI_TIMEOUT_MS=120000
# Set to "off" to skip the prompt-companion rewrite before each image. Halves the model calls
# per image at some cost to prompt quality.
OPENAI_PROMPT_COMPANION=on

# Safety limits
# Hard ceiling on images generated per game. Generation is the only thing that costs money.
MAX_IMAGES_PER_GAME=200
# Hard ceiling on players who can join one game.
MAX_PLAYERS_PER_GAME=60

# Use mock only for local development or CI. Production must use openai.
AI_PROVIDER=openai
